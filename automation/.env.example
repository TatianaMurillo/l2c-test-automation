# Copy this file to .env and fill in real values.
# Never commit .env - credentials must come from CI secrets in real pipelines
# (e.g. GitHub Actions secrets injected by the Gearset webhook workflow).

SF_LOGIN_URL=https://test.salesforce.com
SF_USERNAME=automation.user@yourorg.qa
SF_PASSWORD=changeme
SF_SECURITY_TOKEN=changeme

# Optional: run against a specific sandbox/scratch org alias resolved by CI
SF_ORG_ALIAS=qa-l2c

# Playwright
HEADLESS=true
